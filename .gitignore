# Benchmark source and derived data are local; manifests and bundled legacy inputs remain tracked.
evaluation/benchmark_v02/data/raw/
evaluation/benchmark_v02/data/clean_base/
evaluation/benchmark_v02/data/probe_cache/
evaluation/benchmark_v02/data/incoming/**/*.zip
evaluation/benchmark_v02/data/incoming/**/*.zip.asset.json
evaluation/benchmark_v02/data/incoming/**/*.csv
evaluation/benchmark_v02/data/incoming/**/*.csv.asset.json

# Runtime/test noise.
__pycache__/
*.py[cod]
.pytest_cache/
_pytest_*/
Ts_harness.zip
*.zip

# NOAA fresh cohort local data (raw 2025 csv ~165MB + materialized arrays).
# The children are excluded rather than the directory itself, so the cohort
# manifest can be re-included: it is a frozen-surface member and needs a
# tracked baseline, unlike the arrays it describes.
data/benchmark_noaa_fresh_v1/*
!data/benchmark_noaa_fresh_v1/manifest.json

# Scratch skill-store forks and runtime caches from functional runs.
_scratch/

# --- local-only: do not upload to GitHub ---
# Secrets. Tracked files stay tracked; this only blocks new adds.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json
id_rsa
id_ed25519

# Virtualenvs and Python build noise.
.venv/
.venv*/
venv/
env/
*.egg-info/
dist/
build/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Editors / OS junk.
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
*:Zone.Identifier

# Local datasets and caches. Already-tracked NOAA manifest and UCR roster stay tracked.
data/**
!data/benchmark_noaa_fresh_v1/
!data/benchmark_noaa_fresh_v1/manifest.json
!data/ucr_conf_downloaded/
!data/ucr_conf_downloaded/ROSTER.md

# Large arrays. The already-tracked legacy npz stays tracked.
*.npz
# Artifacts are uploaded; lift the global npz/log/zip bans inside that tree.
!artifacts/**/*.npz
!artifacts/**/*.log
!artifacts/**/*.zip

# Root runtime skill-stores / experiment state (hidden dirs).
.*_store/
.*_store_*/
.*_state/
.*_cache/
