# Benchmark source and derived data are local; manifests and bundled legacy inputs remain tracked.
evaluation/benchmark_v02/data/raw/
evaluation/benchmark_v02/data/clean_base/
evaluation/benchmark_v02/data/probe_cache/
evaluation/benchmark_v02/data/incoming/**/*.zip
evaluation/benchmark_v02/data/incoming/**/*.zip.asset.json
evaluation/benchmark_v02/data/incoming/**/*.csv
evaluation/benchmark_v02/data/incoming/**/*.csv.asset.json

# Runtime/test noise.
__pycache__/
*.py[cod]
.pytest_cache/
_pytest_*/
Ts_harness.zip
*.zip

# NOAA fresh cohort local data (raw 2025 csv ~165MB + materialized arrays).
# The children are excluded rather than the directory itself, so the cohort
# manifest can be re-included: it is a frozen-surface member and needs a
# tracked baseline, unlike the arrays it describes.
data/benchmark_noaa_fresh_v1/*
!data/benchmark_noaa_fresh_v1/manifest.json

# Scratch skill-store forks and runtime caches from functional runs.
_scratch/
