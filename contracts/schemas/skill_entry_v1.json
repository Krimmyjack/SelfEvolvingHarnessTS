{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-entry/1",
  "title": "SkillEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_id",
    "skill_kind",
    "revision",
    "body",
    "observable_applicability",
    "allowed_tools",
    "risk_guards"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-entry/1"
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
    },
    "skill_kind": {
      "enum": [
        "bootstrap_procedure",
        "capability",
        "safety"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "observable_applicability": {
      "type": "object"
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "risk_guards": {
      "type": "object"
    },
    "serving_scope": {
      "$comment": "SCOPE (2026-09-01): optional, so every existing entry still validates. A Skill carries the predicate and never the resolved UIDs: those names do not exist in the next Target, so storing them would make the Skill resolve to nothing there and look like a deliberate abstention.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_type"
      ],
      "properties": {
        "scope_type": {
          "enum": [
            "all_serving_series",
            "serving_series_predicate",
            "none"
          ]
        },
        "predicate": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "feature",
              "op",
              "threshold"
            ],
            "properties": {
              "feature": {
                "$comment": "a deployment-visible feature name; the length and pattern also refuse UID shapes such as 's0' or 'T140'",
                "type": "string",
                "minLength": 4,
                "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
              },
              "op": {
                "enum": [
                  "<=",
                  ">=",
                  "<",
                  ">"
                ]
              },
              "threshold": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
