{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "fast-propose/1",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "candidates"
 ],
 "properties": {
  "candidates": {
   "type": "array",
   "maxItems": 3,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "candidate_id",
     "steps"
    ],
    "properties": {
     "candidate_id": {
      "type": "string",
      "pattern": "^(?!identity$)[a-z][a-z0-9_-]*$"
     },
     "addresses_hypothesis_id": {
      "$comment": "候选对应的 inspect 阶段 pattern_hypotheses.hypothesis_id（SKILL_CONTENT_MIGRATION 2026-08-14：候选生成理由可观察）。可选字段——旧载荷兼容；软强制由 build_contrastive_candidates skill 文本执行。",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
     },
     "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
       "$comment": "canonical operator step branches are injected at load time"
      }
     }
    }
   }
  }
 }
}
