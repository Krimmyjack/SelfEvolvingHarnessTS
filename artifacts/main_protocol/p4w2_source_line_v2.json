      ],
      "operation": "ADD",
      "catalog_is_narrower_than_the_route": "RISK_GAP also authorizes its risk-guard and verification surfaces; this round exposes only the Skill ADD, so a single ruling cannot quietly become licence to edit H0's global scope_risk_guards",
      "route_table_change": {
        "file": "evaluation/minipipe/feedback/fault_routes.json",
        "change": "RISK_GAP.target_classes += ['capability']",
        "additive": true,
        "newly_authorized": [
